{
  "name": "messmate-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "migrate": "node --experimental-transform-types src/migrate.ts",
    "build": "tsc -p tsconfig.build.json",
    "preview:local": "node --experimental-transform-types src/local-preview.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@vercel/blob": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "tsx": "^4.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  }
}
